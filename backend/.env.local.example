# Used only by start-local.ps1, never auto-loaded by deployment.
AM_BYPASS_LOCAL=1
AM_BYPASS_MERCHANT_ID=replace_with_existing_merchant_id
SOCIAL_MEDIA_ORIGIN=http://127.0.0.1:5173
SOCIAL_MEDIA_URL=http://127.0.0.1:5173

MONGODB_URI=mongodb://127.0.0.1:27018
MONGODB_DATABASE=social_media
# Use the existing demo directory during transition, e.g. D:/ai_project/social-media/local_media.
STORAGE_DIR=../local_media
SKILLS_DIR=../.agents/skills

# Local mode still uses the real model services. These calls consume quota.
CORE_AI_GATEWAY_BASE_URL=https://core-ai-server.connexup-uat.net/api/gateway/v1
CORE_AI_SERVER_BASE_URL=https://core-ai-server.connexup-uat.net
CORE_AI_API_KEY=replace_me
IMAGE_HOST_BASE_URL=https://43.139.235.133:5002
IMAGE_HOST_PUBLIC_BASE_URL=https://43.139.235.133/img
IMAGE_HOST_UPLOAD_TOKEN=replace_me

# Local SMB material filtering. Its own model/limits; poster models are untouched.
# The folder TABs are stored in MongoDB and the copies stay under STORAGE_DIR/material-filters.
MATERIAL_FILTER_MODEL=deepseek-v4-flash
MATERIAL_FILTER_CONCURRENCY=2
MATERIAL_FILTER_TIMEOUT_SECONDS=120

# No AM session, AM media service key or COS credentials are needed locally.

# 临时直连 MiniMax 图片模型（core-ai 暂未接入）。删除此段即回到只走 core-ai。
MINIMAX_IMAGE_BASE_URL=https://api.minimax.cn/v1
MINIMAX_IMAGE_API_KEY=replace_me
MINIMAX_IMAGE_MODEL=MiniMax-H3-Image
MINIMAX_IMAGE_TIMEOUT_SECONDS=600
